{
  "$defs": {
    "ErrorType": {
      "enum": [
        "random",
        "systematic"
      ],
      "title": "ErrorType",
      "type": "string"
    },
    "RuleScope": {
      "enum": [
        "single",
        "within_run",
        "across_runs",
        "across_levels_and_runs"
      ],
      "title": "RuleScope",
      "type": "string"
    },
    "RuleViolation": {
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "direction": {
          "enum": [
            "high",
            "low",
            "both"
          ],
          "title": "Direction",
          "type": "string"
        },
        "error_type": {
          "$ref": "#/$defs/ErrorType"
        },
        "levels": {
          "items": {
            "type": "integer"
          },
          "title": "Levels",
          "type": "array"
        },
        "result_ids": {
          "items": {
            "type": "string"
          },
          "title": "Result Ids",
          "type": "array"
        },
        "rule": {
          "$ref": "#/$defs/WestgardRule"
        },
        "scope": {
          "$ref": "#/$defs/RuleScope"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "rule",
        "severity",
        "error_type",
        "scope",
        "direction",
        "levels",
        "result_ids",
        "detail"
      ],
      "title": "RuleViolation",
      "type": "object"
    },
    "RunOutcome": {
      "enum": [
        "accept",
        "warning",
        "reject"
      ],
      "title": "RunOutcome",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "warning",
        "reject"
      ],
      "title": "Severity",
      "type": "string"
    },
    "WestgardRule": {
      "description": "Control rules in Westgard notation (N_L: N observations beyond L).",
      "enum": [
        "1_2s",
        "1_3s",
        "2_2s",
        "R_4s",
        "4_1s",
        "10_x"
      ],
      "title": "WestgardRule",
      "type": "string"
    }
  },
  "$id": "https://github.com/kogunlowo123/lab-quality-control-agents/schemas/run-evaluation.record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Outcome of applying the multirule procedure to one analytical run.",
  "properties": {
    "analyte": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,63}$",
      "title": "Analyte",
      "type": "string"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "evaluation_id": {
      "title": "Evaluation Id",
      "type": "string"
    },
    "history_points": {
      "description": "Prior observations considered",
      "minimum": 0,
      "title": "History Points",
      "type": "integer"
    },
    "instrument_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,63}$",
      "title": "Instrument Id",
      "type": "string"
    },
    "levels": {
      "items": {
        "type": "integer"
      },
      "title": "Levels",
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/RunOutcome"
    },
    "result_ids": {
      "items": {
        "type": "string"
      },
      "title": "Result Ids",
      "type": "array"
    },
    "rules_applied": {
      "items": {
        "$ref": "#/$defs/WestgardRule"
      },
      "title": "Rules Applied",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "run_observed_at": {
      "format": "date-time",
      "title": "Run Observed At",
      "type": "string"
    },
    "violations": {
      "items": {
        "$ref": "#/$defs/RuleViolation"
      },
      "title": "Violations",
      "type": "array"
    }
  },
  "required": [
    "evaluation_id",
    "analyte",
    "instrument_id",
    "run_id",
    "outcome",
    "violations",
    "rules_applied",
    "result_ids",
    "levels",
    "run_observed_at",
    "evaluated_at",
    "history_points"
  ],
  "title": "RunEvaluation",
  "type": "object"
}
